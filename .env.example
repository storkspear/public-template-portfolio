# ─────────────────────────────────────────────────────────────
#  이 파일을 `.env` 로 복사해서 쓰세요.  `cp .env.example .env`
#  `.env` 는 git 에 올라가지 않습니다(.gitignore).
#
#  ⚠ 여기 적힌 값은 **전부 로컬 전용**입니다. 인터넷에 올릴 때는
#     아래 「배포 전에」 부분을 반드시 읽으세요.
# ─────────────────────────────────────────────────────────────

# ── 데이터베이스 ────────────────────────────────────────────
# docker compose 가 띄우는 Postgres. 이 값 그대로 맞습니다.
PGHOST=db
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=localdev

# 이 사이트가 보는 스키마. 연결에 못 박혀 있어서 다른 사이트 글이 안 보입니다.
# 한 기계에서 사이트를 여럿 돌릴 거면 서로 다르게 하세요(site.config.mjs 의 name 과 맞추면 편합니다).
PGSCHEMA=mysite

# ── 관리자 계정 ─────────────────────────────────────────────
# 아이디는 그냥 아이디입니다 — 이메일이 아닙니다.
ADMIN_ID=admin

# ⚠ 로컬 전용입니다. 이 값으로는 **localhost 밖에서 서버가 뜨지 않습니다**
#    (server/admin-api.mjs 가 거부합니다).
#
# 배포 전에: 이 줄을 비우고, 서버에서 직접 정하세요.
#   node --env-file=.env server/set-password.mjs admin
ADMIN_PASSWORD=admin

# 로그인 토큰 서명 비밀(HMAC-SHA256).
# 이 값을 바꾸면 모든 로그인이 풀립니다 = 「모든 기기에서 로그아웃」.
#
# 배포 전에: 반드시 새로 뽑으세요. 사이트마다 다른 값이어야 합니다.
#   node -p "require('node:crypto').randomBytes(32).toString('base64url')"
ADMIN_TOKEN_SECRET=local-dev-only-do-not-use-in-production-0123456789

# ── 파일이 사는 곳 ──────────────────────────────────────────
# 구운 HTML + 올린 사진 원본. docker 에서는 이름 붙은 볼륨이라 컨테이너를 지워도 남습니다.
BLOG_DIR=/data/blog

# 지운 글이 가는 곳. 비우면 BLOG_DIR 의 형제 폴더.
#TRASH_DIR=/data/trash

# 첫 화면(/)과 포트폴리오(/portfolio/)가 구워지는 곳.
# ⚠ BLOG_DIR 과 같은 값이면 부팅하지 않습니다 — 화면 굽기가 사진 원본을 지웁니다.
#   여기에는 다시 만들 수 있는 것만 있어 통째로 지워도 잃을 것이 없습니다.
#PAGES_DIR=/data/www

# 「모양」 화면의 미리보기가 구워지는 곳. 관리자 포트에서만 열립니다 —
# 저장 전의 모양이라 공개면에 나가면 안 됩니다.
#PREVIEW_DIR=/data/preview

# ── 포트 ────────────────────────────────────────────────────
# 컨테이너 안에서 API 가 듣는 포트. 밖으로는 열리지 않습니다.
PORT=8090

# 밖에서 닿는 주소. 이미 쓰고 있는 포트면 여기서 비키세요.
#   http://localhost:{WEB_PORT}    공개 화면
#   http://localhost:{ADMIN_PORT}  관리자
# ⚠ WEB_PORT 를 바꾸면 site.config.mjs 의 origin 도 같이 바꾸세요 —
#    발행된 글이 제 주소를 그 값으로 적습니다.
WEB_PORT=8080
ADMIN_PORT=8081

# DB 에 TLS 를 걸지. 비워 두면 site.config.mjs 의 origin 이 localhost 인지로 정합니다.
# 관리형 Postgres 를 쓰면서 자동 판단이 틀릴 때만 on/off 로 못 박으세요.
#PGSSL=on
